# Server Configuration
PORT=5000

# OpenAI Configuration (Optional - runs in Demo AI Mode if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini Configuration (Optional - runs in Demo AI Mode if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Default AI Provider: auto | openai | gemini | demo
DEFAULT_AI_PROVIDER=auto
